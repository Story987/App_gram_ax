name: 📝 Markdown Pipeline

on:
  push:
    branches:
      - main
      - develop
      - 'Ветка_Тест1'          # Добавлена ваша тестовая ветка
      - '**'                   # Опционально: можно раскомментировать для всех веток
  pull_request:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  markdown-processing:
    name: 🔍 Проверка и конвертация .md файлов
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4.2.2
        with:
          fetch-depth: 0

      - name: 🟢 Setup Node.js
        uses: actions/setup-node@v4.3.0
        with:
          node-version: '22'

      - name: 📦 Install markdown tools
        run: |
          npm install -g markdownlint-cli
          npm install -g marked
          npm install -g prettier

      - name: 🔍 Lint Markdown files
        continue-on-error: true
        run: |
          echo "🔍 Проверяем все .md файлы..."
          find . -name "*.md" -not -path "./node_modules/*" -not -path "./.git/*" -print0 | xargs -0 markdownlint || true
          echo "✅ Проверка завершена"

      - name: 💅 Format Markdown files
        continue-on-error: true
        run: |
          echo "💅 Форматируем .md файлы..."
          find . -name "*.md" -not -path "./node_modules/*" -not -path "./.git/*" -print0 | xargs -0 prettier --write --prose-wrap=always || true
          echo "✅ Форматирование завершено"

      - name: 🌐 Convert MD to HTML
        run: |
          echo "🌐 Конвертируем .md в .html..."
          mkdir -p html_output
          find . -name "*.md" -not -path "./node_modules/*" -not -path "./.git/*" -print0 | while IFS= read -r -d '' file; do
            relpath=$(realpath --relative-to="." "$file" | sed 's/\.md$//')
            mkdir -p "html_output/$(dirname "$relpath")"
            marked "$file" > "html_output/${relpath}.html"
            echo "  ✅ ${file} → html_output/${relpath}.html"
          done
          echo "✅ Конвертация завершена"

      - name: 📋 Generate Markdown index
        run: |
          echo "📋 Генерируем индекс всех .md файлов..."
          echo "# 📚 Список Markdown файлов в репозитории" > INDEX.md
          echo "" >> INDEX.md
          echo "**Ветка:** ${{ github.ref_name }}" >> INDEX.md
          echo "**Всего файлов:** $(find . -name "*.md" -not -path "./node_modules/*" -not -path "./.git/*" | wc -l)" >> INDEX.md
          echo "" >> INDEX.md
          echo "| Файл | Путь |" >> INDEX.md
          echo "|------|------|" >> INDEX.md
          find . -name "*.md" -not -path "./node_modules/*" -not -path "./.git/*" | sort | while read file; do
            clean_file="${file#./}"
            echo "| [${clean_file}](${clean_file}) | \`${clean_file}\` |" >> INDEX.md
          done
          echo "✅ Индекс создан: INDEX.md"

      - name: 📦 Upload artifacts
        uses: actions/upload-artifact@v4.4.3
        with:
          name: markdown-output-${{ github.ref_name }}  # Уникальное имя для каждой ветки
          path: |
            *.md
            html_output/
            INDEX.md
          retention-days: 30

      - name: 📁 Prepare for GitHub Pages (только для main)
        if: github.ref == 'refs/heads/main'
        run: |
          mkdir -p pages_output
          cp -r html_output/* pages_output/
          cat > pages_output/index.html << 'EOF'
          <!DOCTYPE html>
          <html>
          <head><meta charset="UTF-8"><title>📚 Документация</title>
          <style>body{font-family:sans-serif;max-width:800px;margin:auto;padding:2rem;line-height:1.6}
          h1{color:#2c3e50}a{color:#3498db;text-decoration:none}a:hover{text-decoration:underline}
          li{margin:0.5rem 0}
          .file-size{color:#7f8c8d;font-size:0.9rem}
          </style>
          </head>
          <body>
          <h1>📚 Документация из Markdown</h1>
          <p>Сгенерировано автоматически из <code>.md</code> файлов репозитория.</p>
          <hr>
          <ul>
          EOF
          find pages_output -name "*.html" -not -name "index.html" | sort | while read file; do
            rel="${file#pages_output/}"
            name=$(basename "$rel" .html)
            echo "<li><a href=\"$rel\">$name</a> <span class=\"file-size\">(.html)</span></li>" >> pages_output/index.html
          done
          echo '</ul><hr><p><small>Автоматическая сборка от $(date)</small></p></body></html>' >> pages_output/index.html

      - name: 📤 Upload Pages artifact (только для main)
        if: github.ref == 'refs/heads/main'
        uses: actions/upload-pages-artifact@v3
        with:
          path: pages_output

  deploy:
    name: 🚀 Deploy to GitHub Pages
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    needs: markdown-processing
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: 🚀 Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

  check-links:
    name: 🔗 Проверка битых ссылок
    runs-on: ubuntu-latest
    needs: markdown-processing
    if: always() && needs.markdown-processing.result != 'cancelled'
    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4.2.2

      - name: 🔗 Check broken links
        uses: gaurav-nelson/github-action-markdown-link-check@v1
        with:
          use-quiet-mode: 'yes'
          use-verbose-mode: 'yes'
          folder-path: '.'
          file-path: '*.md'
          max-depth: 2
        continue-on-error: true
